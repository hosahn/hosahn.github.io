---
interface Props {
  selectedCategory: string;
  categoryList: Record<string, number>;
}

const { selectedCategory, categoryList } = Astro.props;
---
<div class="category-section">
  <div class="section-label">
    <span class="bracket">[</span>
    <span class="label-text">filter::categories</span>
    <span class="bracket">]</span>
  </div>
  <div class="category-list">
    {Object.entries(categoryList).map(([name, count]) => (
      <a
        class:list={["category-item", { active: name === selectedCategory }]}
        href={`/?category=${name}`}
        data-category={name}
      >
        <span class="hash">#</span>{name}
        <span class="count">{count}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .category-section {
    width: 768px;
    margin: 60px auto 0;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .bracket {
    color: var(--accent);
  }

  .label-text {
    color: var(--text-muted);
  }

  .category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .category-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 4px;
    transition: all 0.15s ease;
  }

  .category-item:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-shadow: none;
  }

  .category-item.active {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 16px var(--accent-glow);
  }

  .category-item.active:hover {
    color: var(--bg);
  }

  .hash {
    opacity: 0.7;
  }

  .count {
    font-size: 11px;
    margin-left: 4px;
    opacity: 0.6;
  }

  .category-item.active .count {
    opacity: 0.85;
  }

  @media (max-width: 768px) {
    .category-section {
      width: 100%;
      margin-top: 40px;
      padding: 0 20px;
    }
    .category-item {
      font-size: 12px;
      padding: 5px 12px;
    }
  }
</style>
