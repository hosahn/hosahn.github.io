---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  date: string;
  categories: string[];
  thumbnail?: ImageMetadata;
}

const { title, date, categories, thumbnail } = Astro.props;
---
<header class="post-head">
  {thumbnail && (
    <Image src={thumbnail} alt="thumbnail" width={1536} height={400} class="bg" />
  )}
  <div class="overlay" aria-hidden="true"></div>
  <div class="info">
    <a class="back" href="javascript:history.back()" aria-label="Go back">
      <span class="back-arrow">←</span>
      <span class="back-text">cd ..</span>
    </a>
    <div class="path-line">
      <span class="path-prompt">root@blog:~/posts/</span>
      <span class="path-current">{date.replaceAll('.', '').slice(0, 6)}</span>
    </div>
    <h1 class="title">{title}</h1>
    <div class="post-data">
      <div class="categories">
        {categories.map((c) => <span class="cat">#{c}</span>)}
      </div>
      <div class="date">{date}</div>
    </div>
  </div>
</header>

<style>
  .post-head {
    position: relative;
    width: 100%;
    min-height: 420px;
    background: var(--bg-elev);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.3) saturate(0.7);
    border: none;
    margin: 0;
    border-radius: 0;
  }

  .overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(17, 25, 39, 0.5) 0%, rgba(17, 25, 39, 0.95) 100%),
      radial-gradient(ellipse at top right, rgba(159, 239, 0, 0.1), transparent 60%);
  }

  .info {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    width: 768px;
    margin: 0 auto;
    padding: 40px 0 60px;
  }

  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    background: rgba(159, 239, 0, 0.08);
    border: 1px solid var(--accent);
    border-radius: 3px;
    margin-bottom: 32px;
    transition: all 0.15s ease;
  }

  .back:hover {
    background: var(--accent);
    color: var(--bg);
    text-shadow: none;
  }

  .back-arrow {
    font-size: 16px;
    line-height: 1;
  }

  .path-line {
    font-family: var(--font-mono);
    font-size: 13px;
    margin-bottom: 18px;
    color: var(--text-muted);
  }

  .path-prompt {
    color: var(--text-muted);
  }

  .path-current {
    color: var(--accent);
  }

  .title {
    color: var(--heading);
    font-size: 44px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
    overflow-wrap: break-word;
  }

  .post-data {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-size: 14px;
    flex-wrap: wrap;
  }

  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .cat {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 3px 8px;
    border-radius: 3px;
    background: rgba(159, 239, 0, 0.1);
    border: 1px solid rgba(159, 239, 0, 0.3);
    color: var(--accent);
  }

  .date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .info {
      width: 100%;
      padding: 30px 20px 50px;
    }
    .title {
      font-size: 28px;
    }
  }
</style>
