---
const year = new Date().getFullYear();
---
<footer>
  <div class="footer-inner">
    <div class="prompt">
      <span class="user">hosan@blog</span><span class="sep">:</span><span class="path">~</span><span class="dollar">$</span>
      <span class="cmd">echo "Thanks for visiting!"</span>
    </div>
    <p class="msg">
      If you are interested in building a CTF Team, please <a href="/contact">contact me</a>.
    </p>
    <p class="copy">
      © {year} Hosan Lee, Munich.
      <a target="_blank" rel="noopener" href="https://icons8.com/icon/37287/footman">Footman icon by Icons8</a>
    </p>
  </div>
</footer>

<style>
  footer {
    margin-top: auto;
    padding: 60px 20px 40px;
    border-top: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--text-muted);
    font-size: 14px;
    text-align: center;
    line-height: 1.6;
  }

  .footer-inner {
    max-width: 768px;
    margin: 0 auto;
  }

  .prompt {
    font-family: var(--font-mono);
    font-size: 13px;
    margin-bottom: 16px;
    color: var(--text-muted);
  }

  .user {
    color: var(--accent);
  }
  .sep {
    color: var(--text-muted);
  }
  .path {
    color: #6fb1ff;
  }
  .dollar {
    color: var(--accent);
    margin: 0 6px;
  }
  .cmd {
    color: var(--text);
  }

  .msg {
    color: var(--text);
    margin-bottom: 8px;
  }

  .msg a {
    color: var(--accent);
    border-bottom: 1px dashed var(--accent);
  }

  .copy {
    margin-top: 6px;
    font-size: 12px;
    color: var(--text-muted);
  }

  .copy a {
    color: var(--text-muted);
  }
  .copy a:hover {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    footer {
      font-size: 13px;
    }
  }
</style>
