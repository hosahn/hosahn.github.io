---
---
<section class="hero">
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="wrapper">
    <div class="profile-ring">
      <img src="/profile-image.jpg" alt="Hosan profile" width="120" height="120" class="profile" loading="eager" />
    </div>
    <div class="text">
      <div class="status-line">
        <span class="dot"></span>
        <span class="status-text">SYSTEM ONLINE</span>
        <span class="ts">{new Date().toISOString().slice(0, 10)}</span>
      </div>
      <h1 class="title">
        Welcome to <span class="title-accent">Hosan's Security Blog</span>
      </h1>
      <p class="subtitle">
        <span class="prompt">$</span> sometimes we need <span class="kw">solution</span>,
        sometimes we need <span class="kw">sleep</span><span class="cursor">_</span>
      </p>
      <div class="tags">
        <span class="tag">CTF</span>
        <span class="tag">PENTEST</span>
        <span class="tag">CYBERSEC</span>
        <span class="tag">CS</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    overflow: hidden;
    background:
      radial-gradient(ellipse at top, rgba(159, 239, 0, 0.08), transparent 60%),
      linear-gradient(180deg, #0d1422 0%, #111927 100%);
    border-bottom: 1px solid var(--border);
  }

  .grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.15;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
    pointer-events: none;
  }

  .wrapper {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 40px;
    width: 768px;
    min-height: 360px;
    margin: 0 auto;
    padding: 60px 0;
  }

  .profile-ring {
    flex-shrink: 0;
    width: 140px;
    height: 140px;
    padding: 4px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), transparent 70%);
    box-shadow: 0 0 30px var(--accent-glow);
  }

  .profile {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 3px solid var(--bg);
    object-fit: cover;
    margin: 0;
    background: var(--bg-elev);
  }

  .text {
    flex: 1;
    min-width: 0;
  }

  .status-line {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 16px;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elev);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .status-text {
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .ts {
    color: var(--text-muted);
    margin-left: 4px;
  }

  .title {
    font-size: 38px;
    font-weight: 800;
    color: var(--heading);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }

  .title-accent {
    color: var(--accent);
    text-shadow: 0 0 24px var(--accent-glow);
  }

  .subtitle {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--text);
    margin: 0 0 20px;
  }

  .prompt {
    color: var(--accent);
    margin-right: 6px;
  }

  .kw {
    color: var(--accent);
  }

  .cursor {
    color: var(--accent);
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    border-radius: 3px;
    background: rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 768px) {
    .wrapper {
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      padding: 50px 20px;
      gap: 24px;
    }
    .title {
      font-size: 28px;
    }
    .profile-ring {
      width: 100px;
      height: 100px;
    }
  }
</style>
