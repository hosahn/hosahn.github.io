---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Introduction from '@components/Introduction.astro';
import CategoryList from '@components/CategoryList.astro';
import PostItem from '@components/PostItem.astro';
import { dateToSlug, formatDate } from '../lib/slug';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const categoryList: Record<string, number> = { All: posts.length };
for (const post of posts) {
  for (const category of post.data.categories) {
    categoryList[category] = (categoryList[category] ?? 0) + 1;
  }
}

const url = new URL(Astro.request.url);
const selectedCategory = url.searchParams.get('category') || 'All';

const cards = posts.map((post) => ({
  link: `/${dateToSlug(post.data.date)}/`,
  title: post.data.title,
  date: formatDate(post.data.date),
  categories: post.data.categories,
  summary: post.data.summary,
  thumbnail: post.data.thumbnail,
}));
---
<BaseLayout
  title="Hosan's Security Blog"
  description="Basically focusing on CTF Challenges, Cyber Security and CS"
>
  <Introduction />
  <CategoryList selectedCategory={selectedCategory} categoryList={categoryList} />

  <section class="post-section">
    <div class="section-label">
      <span class="bracket">[</span>
      <span class="label-text">posts.list</span>
      <span class="bracket">]</span>
      <span class="count" data-result-count>{cards.length} entries</span>
    </div>
    <div class="post-list" id="post-list">
      {cards.map((post) => (
        <div class="post-cell" data-categories={post.categories.join('|')}>
          <PostItem {...post} />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const initial = params.get('category') || 'All';
  const cells = document.querySelectorAll<HTMLDivElement>('.post-cell');
  const counter = document.querySelector<HTMLSpanElement>('[data-result-count]');

  function applyFilter(category: string) {
    let visible = 0;
    cells.forEach((cell) => {
      if (category === 'All') {
        cell.style.display = '';
        visible++;
        return;
      }
      const cats = (cell.dataset.categories || '').split('|');
      const match = cats.includes(category);
      cell.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    if (counter) counter.textContent = `${visible} entries`;
  }

  applyFilter(initial);

  document.querySelectorAll<HTMLAnchorElement>('.category-section .category-item').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const category = link.dataset.category || 'All';
      const newParams = new URLSearchParams(window.location.search);
      if (category === 'All') {
        newParams.delete('category');
      } else {
        newParams.set('category', category);
      }
      const qs = newParams.toString();
      const next = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
      window.history.pushState({}, '', next);
      document.querySelectorAll<HTMLAnchorElement>('.category-section .category-item').forEach((other) => {
        other.classList.toggle('active', (other.dataset.category || 'All') === category);
      });
      applyFilter(category);
    });
  });
</script>

<style>
  .post-section {
    width: 768px;
    margin: 50px auto 0;
    padding-bottom: 80px;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .section-label .bracket {
    color: var(--accent);
  }

  .section-label .count {
    margin-left: auto;
    color: var(--accent);
    font-size: 11px;
  }

  .post-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  @media (max-width: 768px) {
    .post-section {
      width: 100%;
      padding: 0 20px 60px;
      margin-top: 40px;
    }
    .post-list {
      grid-template-columns: 1fr;
    }
  }
</style>
