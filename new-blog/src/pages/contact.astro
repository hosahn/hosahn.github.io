---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Contact Hosan">
  <section class="contact">
    <div class="contact-card">
      <div class="card-header">
        <div class="card-dots">
          <span></span><span></span><span></span>
        </div>
        <span class="card-title">contact.sh</span>
      </div>

      <div class="card-body">
        <div class="prompt-line">
          <span class="prompt-user">root@blog</span>
          <span class="sep">:</span>
          <span class="path">~</span>
          <span class="dollar">$</span>
          <span class="cmd">./contact_me</span>
        </div>

        <h1 class="title">> Initiate <span class="accent">connection</span></h1>
        <p class="desc">
          Got a question, idea, or want to build a CTF team? Send a packet through the form below.
        </p>

        <form id="contact-form" class="form">
          <div class="row">
            <label for="user_name">--name</label>
            <input type="text" id="user_name" name="user_name" placeholder="enter your name..." required />
          </div>

          <div class="row">
            <label for="user_email">--email</label>
            <input type="email" id="user_email" name="user_email" placeholder="you@example.com" required />
          </div>

          <div class="row">
            <label for="user_message">--message</label>
            <textarea id="user_message" name="message" placeholder="type your message..." required></textarea>
          </div>

          <button type="submit" class="submit">
            <span class="arrow">$</span> Send packet
          </button>

          <p class="note">
            <span class="info">[INFO]</span> No personal data is stored on this server.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import emailjs from '@emailjs/browser';

  const SERVICE_ID = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID || 'service_msuqzo9';
  const TEMPLATE_ID = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID || 'template_tv2z1va';
  const PUBLIC_KEY = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY || 'Vyi75khtxAhxilOrs';

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = '[ sending... ]';
    }
    const name = (document.getElementById('user_name') as HTMLInputElement).value;
    const email = (document.getElementById('user_email') as HTMLInputElement).value;
    const message = (document.getElementById('user_message') as HTMLTextAreaElement).value;

    try {
      await emailjs.send(
        SERVICE_ID,
        TEMPLATE_ID,
        {
          from_name: name,
          from_email: email,
          to_name: 'Hosan Lee',
          message: `${message}\n\n${email}\n${name}`,
        },
        PUBLIC_KEY,
      );
      alert('Packet delivered. Connection closed.');
      form.reset();
      window.location.reload();
    } catch (error) {
      console.error(error);
      alert('Connection failed. Please try again.');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span class="arrow">$</span> Send packet';
      }
    }
  });
</script>

<style>
  .contact {
    max-width: 720px;
    margin: 60px auto;
    padding: 0 20px;
  }

  .contact-card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: #0d1422;
    border-bottom: 1px solid var(--border);
  }

  .card-dots {
    display: flex;
    gap: 6px;
  }

  .card-dots span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #4a5568;
  }
  .card-dots span:nth-child(1) {
    background: #ff5f56;
  }
  .card-dots span:nth-child(2) {
    background: #ffbd2e;
  }
  .card-dots span:nth-child(3) {
    background: #27c93f;
  }

  .card-title {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
  }

  .card-body {
    padding: 32px;
  }

  .prompt-line {
    font-family: var(--font-mono);
    font-size: 13px;
    margin-bottom: 24px;
  }

  .prompt-user {
    color: var(--accent);
  }
  .sep {
    color: var(--text-muted);
  }
  .path {
    color: #6fb1ff;
  }
  .dollar {
    color: var(--accent);
    margin: 0 6px;
  }
  .cmd {
    color: var(--text);
  }

  .title {
    font-size: 32px;
    color: var(--heading);
    margin: 0 0 12px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .accent {
    color: var(--accent);
    text-shadow: 0 0 16px var(--accent-glow);
  }

  .desc {
    color: var(--text-muted);
    margin-bottom: 28px;
    line-height: 1.6;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .row label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    letter-spacing: 0.03em;
  }

  .row input,
  .row textarea {
    width: 100%;
    padding: 12px 14px;
    background: #0d1422;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.5;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .row textarea {
    min-height: 220px;
    resize: vertical;
    font-family: var(--font-sans);
  }

  .row input::placeholder,
  .row textarea::placeholder {
    color: var(--text-muted);
    opacity: 0.6;
  }

  .row input:focus,
  .row textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .submit {
    align-self: flex-start;
    padding: 12px 22px;
    background: var(--accent);
    color: var(--bg);
    border: 1px solid var(--accent);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .submit:hover:not(:disabled) {
    background: transparent;
    color: var(--accent);
    box-shadow: 0 0 20px var(--accent-glow);
  }

  .submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .submit .arrow {
    margin-right: 4px;
  }

  .note {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  .info {
    color: var(--accent);
    margin-right: 4px;
  }

  @media (max-width: 768px) {
    .card-body {
      padding: 24px 20px;
    }
    .title {
      font-size: 24px;
    }
  }
</style>
