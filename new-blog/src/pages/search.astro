---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PostItem from '@components/PostItem.astro';
import { dateToSlug, formatDate } from '../lib/slug';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const cards = posts.map((post) => ({
  link: `/${dateToSlug(post.data.date)}/`,
  title: post.data.title,
  date: formatDate(post.data.date),
  categories: post.data.categories,
  summary: post.data.summary,
  thumbnail: post.data.thumbnail,
}));
---
<BaseLayout
  title="Search"
  description="Search posts about CTF, pentest, cyber security, computer science"
>
  <section class="search">
    <div class="search-card">
      <div class="search-header">
        <span class="bracket">[</span>
        <span class="label">grep::posts</span>
        <span class="bracket">]</span>
      </div>
      <div class="search-input-wrap">
        <span class="prompt">$</span>
        <input
          id="search-input"
          type="text"
          placeholder="grep -i 'pattern' ./posts/*.md"
          aria-label="Search posts"
          autofocus
        />
      </div>
      <div class="search-meta" data-search-meta>type to search by title, summary, or category</div>
    </div>

    <div id="search-results" class="results">
      {cards.map((post) => (
        <div
          class="result-cell"
          data-title={post.title.toLowerCase()}
          data-summary={post.summary.toLowerCase()}
          data-categories={post.categories.join('|').toLowerCase()}
          hidden
        >
          <PostItem {...post} />
        </div>
      ))}
      <p class="empty" data-empty hidden>// no results</p>
    </div>
  </section>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const cells = document.querySelectorAll<HTMLDivElement>('.result-cell');
  const meta = document.querySelector<HTMLDivElement>('[data-search-meta]');
  const empty = document.querySelector<HTMLParagraphElement>('[data-empty]');

  function render(query: string) {
    const q = query.toLowerCase().trim();
    if (!q) {
      cells.forEach((cell) => (cell.hidden = true));
      if (empty) empty.hidden = true;
      if (meta) meta.textContent = 'type to search by title, summary, or category';
      return;
    }
    let count = 0;
    cells.forEach((cell) => {
      const haystack = `${cell.dataset.title || ''}\n${cell.dataset.summary || ''}\n${cell.dataset.categories || ''}`;
      const match = haystack.includes(q);
      cell.hidden = !match;
      if (match) count++;
    });
    if (meta) meta.textContent = `${count} match${count === 1 ? '' : 'es'} for "${q}"`;
    if (empty) empty.hidden = count !== 0;
  }

  input?.addEventListener('input', () => render(input.value));
</script>

<style>
  .search {
    max-width: 768px;
    margin: 60px auto 80px;
    padding: 0 20px;
  }

  .search-card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .search-header {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .bracket {
    color: var(--accent);
  }

  .search-input-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #0d1422;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 12px 14px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .search-input-wrap:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .prompt {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 700;
  }

  #search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 15px;
  }

  #search-input::placeholder {
    color: var(--text-muted);
    opacity: 0.5;
  }

  .search-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 12px;
  }

  .results {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 30px;
  }

  .empty {
    grid-column: 1 / -1;
    text-align: center;
    font-family: var(--font-mono);
    color: var(--text-muted);
    padding: 40px 0;
  }

  @media (max-width: 768px) {
    .results {
      grid-template-columns: 1fr;
    }
  }
</style>
